{
  "name": "@ankhorage/projects",
  "version": "0.3.0",
  "description": "Standalone project identity and repository actions.",
  "keywords": [
    "ankhorage",
    "projects",
    "persistence"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/projects#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/projects/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/projects.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    }
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "knip:check": "ankhorage-knip",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "version-packages": "ankhorage-changeset version"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.5.0",
    "@ankhorage/paradox": "^0.3.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@ankhorage/api": "^0.5.1",
    "@ankhorage/contracts": "^26.11.1",
    "@ankhorage/utility": "^1.10.0"
  },
  "ankh": {
    "category": "projects",
    "capabilities": [
      {
        "id": "projects.list",
        "owner": "@ankhorage/projects",
        "access": [
          "read"
        ],
        "binding": {
          "kind": "storage",
          "bindableAs": [
            "target"
          ]
        },
        "label": "List projects",
        "description": "List persisted project identities."
      },
      {
        "id": "projects.read",
        "owner": "@ankhorage/projects",
        "access": [
          "read"
        ],
        "binding": {
          "kind": "storage",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Read project",
        "description": "Read one persisted project by identity."
      },
      {
        "id": "projects.create",
        "owner": "@ankhorage/projects",
        "access": [
          "write"
        ],
        "binding": {
          "kind": "storage",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Create project",
        "description": "Create one persisted project with a canonical identity."
      },
      {
        "id": "projects.update",
        "owner": "@ankhorage/projects",
        "access": [
          "write"
        ],
        "binding": {
          "kind": "storage",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Update project",
        "description": "Update one existing persisted project."
      },
      {
        "id": "projects.save",
        "owner": "@ankhorage/projects",
        "access": [
          "write"
        ],
        "binding": {
          "kind": "storage",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Save project manifest",
        "description": "Persist a validated AppManifest draft as an immutable project revision."
      },
      {
        "id": "projects.reload",
        "owner": "@ankhorage/projects",
        "access": [
          "read"
        ],
        "binding": {
          "kind": "storage",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Reload project manifest",
        "description": "Read the persisted project manifest draft and immutable revision history."
      },
      {
        "id": "projects.revision",
        "owner": "@ankhorage/projects",
        "access": [
          "read"
        ],
        "binding": {
          "kind": "storage",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Read project manifest revision",
        "description": "Read one immutable project manifest revision by identity."
      },
      {
        "id": "projects.materialize",
        "owner": "@ankhorage/projects",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Materialize project revision",
        "description": "Materialize one stored immutable project revision through an injected owner generator."
      },
      {
        "id": "projects.delete",
        "owner": "@ankhorage/projects",
        "access": [
          "write"
        ],
        "binding": {
          "kind": "storage",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Delete project",
        "description": "Delete one persisted project by identity."
      }
    ]
  }
}
